{
  "name": "drupal/ckeditor_find",
  "description": "This plugin module adds the find and replace dialog to CKEditor in Drupal 8",
  "type": "drupal-module",
  "license": "GPL-2.0+",
  "require": {
    "composer/installers": "^1.0.24",
    "ckeditor/find": "*"
  },
  "minimum-stability": "dev",
  "homepage": "https://drupal.org/project/ckeditor_find",
  "authors": [
    {
      "name": "Dan Hansen (dhansen)",
      "homepage": "https://www.drupal.org/u/dhansen",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://drupal.org/project/issues/ckeditor_find",
    "source": "http://cgit.drupalcode.org/ckeditor_find"
  },
  "extra": {
    "installer-paths": {
      "libraries/ckeditor/plugins/{$name}": ["ckeditor/find"]
    }
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "ckeditor/find",
        "version": "4.8.0",
        "type": "drupal-library",
        "extra": {
          "installer-name": "find"
        },
        "dist": {
          "url": "https://download.ckeditor.com/find/releases/find_4.8.0.zip",
          "type": "zip"
        }
      }
    }
  ]
}